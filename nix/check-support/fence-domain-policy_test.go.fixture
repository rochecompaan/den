package proxy

import (
	"os"
	"slices"
	"testing"

	"github.com/Use-Tusk/fence/internal/config"
)

func TestDenProjectPolicyDomainDecisions(t *testing.T) {
	policyPath := os.Getenv("DEN_POLICY_PATH")
	projectDomain := os.Getenv("DEN_PROJECT_DOMAIN")
	if policyPath == "" || projectDomain == "" {
		t.Fatal("DEN_POLICY_PATH and DEN_PROJECT_DOMAIN are required")
	}
	cfg, err := config.Load(policyPath)
	if err != nil {
		t.Fatalf("load project policy with Fence config consumer: %v", err)
	}
	if cfg == nil {
		t.Fatal("Fence config consumer returned no policy")
	}
	otherDomain := "pi.project.test"
	if projectDomain == otherDomain {
		otherDomain = "claude.project.test"
	}
	filter := CreateDomainFilter(cfg, false)
	for _, test := range []struct {
		host    string
		allowed bool
	}{
		{host: "api.project.test", allowed: true},
		{host: projectDomain, allowed: true},
		{host: "worker.services.project.test", allowed: true},
		{host: otherDomain, allowed: false},
		{host: "unlisted.project.test", allowed: false},
		{host: "github.com", allowed: false},
		{host: "api.github.com", allowed: false},
		{host: "raw.githubusercontent.com", allowed: false},
		{host: "gitlab.com", allowed: false},
		{host: "api.gitlab.com", allowed: false},
		{host: "bitbucket.org", allowed: false},
		{host: "api.bitbucket.org", allowed: false},
		{host: "metadata.google.internal", allowed: false},
		{host: "169.254.169.254", allowed: false},
		{host: "statsig.anthropic.com", allowed: false},
	} {
		t.Run(test.host, func(t *testing.T) {
			if got := filter(test.host, 443); got != test.allowed {
				t.Fatalf("Fence CreateDomainFilter(%q) = %v, want %v", test.host, got, test.allowed)
			}
		})
	}
}

func TestDenPolicyDomainDecisions(t *testing.T) {
	policyPath := os.Getenv("DEN_POLICY_PATH")
	if policyPath == "" {
		t.Fatal("DEN_POLICY_PATH is required")
	}
	cfg, err := config.Load(policyPath)
	if err != nil {
		t.Fatalf("load Den policy with Fence config consumer: %v", err)
	}
	if cfg == nil {
		t.Fatal("Fence config consumer returned no policy")
	}
	if !slices.Contains(cfg.Network.AllowedDomains, "*.anthropic.com") {
		t.Fatal("test setup: Den policy must allow *.anthropic.com")
	}
	if !slices.Contains(cfg.Network.DeniedDomains, "statsig.anthropic.com") {
		t.Fatal("test setup: Den policy must deny statsig.anthropic.com")
	}

	// IP-literal broker hosts use exact allowlist entries, not local outbound grants.
	cfg.Network.AllowedDomains = append(cfg.Network.AllowedDomains,
		"172.17.0.1", "127.0.0.1", "2001:db8::1", "::1",
	)
	filter := CreateDomainFilter(cfg, false)
	for _, test := range []struct {
		name    string
		host    string
		port    int
		allowed bool
	}{
		{name: "denied Statsig wins over Anthropic wildcard", host: "statsig.anthropic.com", port: 443, allowed: false},
		{name: "unmatched outbound is denied", host: "unlisted.example.test", port: 443, allowed: false},
		{name: "non-denied Anthropic sibling is allowed", host: "api.anthropic.com", port: 443, allowed: true},
		{name: "ChatGPT default is allowed", host: "chatgpt.com", port: 443, allowed: true},
		{name: "ChatGPT subdomains are not implicit", host: "unlisted.chatgpt.com", port: 443, allowed: false},
		{name: "OpenAI API is not implicit", host: "api.openai.com", port: 443, allowed: false},
		{name: "configured IPv4 broker is allowed", host: "172.17.0.1", port: 8443, allowed: true},
		{name: "other private IPv4 is denied", host: "172.17.0.2", port: 8443, allowed: false},
		{name: "configured IPv4 loopback is allowed", host: "127.0.0.1", port: 8443, allowed: true},
		{name: "other IPv4 loopback is denied", host: "127.0.0.2", port: 8443, allowed: false},
		{name: "configured IPv6 broker is allowed", host: "2001:db8::1", port: 8443, allowed: true},
		{name: "other IPv6 is denied", host: "2001:db8::2", port: 8443, allowed: false},
		{name: "configured IPv6 loopback is allowed", host: "::1", port: 8443, allowed: true},
		{name: "metadata IP stays denied", host: "169.254.169.254", port: 8443, allowed: false},
	} {
		t.Run(test.name, func(t *testing.T) {
			if got := filter(test.host, test.port); got != test.allowed {
				t.Fatalf("Fence CreateDomainFilter(%q) = %v, want %v", test.host, got, test.allowed)
			}
		})
	}
}
