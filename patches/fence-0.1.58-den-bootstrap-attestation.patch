+func readLinuxBootstrapProcessInfoAt(procRoot string) (linuxBootstrapProcessInfo, error) {
+	currentExecutable, err := os.Stat(filepath.Join(procRoot, "exe"))
+	if err != nil {
+		return linuxBootstrapProcessInfo{}, fmt.Errorf("inspect current executable: %w", err)
+	}
+	stagedExecutable, err := os.Stat(procRoot + "/root" + linuxBootstrapFencePath)
+	if err != nil {
+		return linuxBootstrapProcessInfo{}, fmt.Errorf("inspect staged Fence executable: %w", err)
+	}
+
+	cmdline, err := os.Open(filepath.Join(procRoot, "cmdline"))
+	if err != nil {
+		return linuxBootstrapProcessInfo{}, fmt.Errorf("open current argv: %w", err)
+	}
+	defer func() { _ = cmdline.Close() }()
+	maxBytes := int64(linuxArgvExecMaxArgs * (linuxArgvExecMaxStringBytes + 1))
+	rawArgv, err := io.ReadAll(io.LimitReader(cmdline, maxBytes+1))
+	if err != nil {
+		return linuxBootstrapProcessInfo{}, fmt.Errorf("read current argv: %w", err)
+	}
+	if int64(len(rawArgv)) > maxBytes {
+		return linuxBootstrapProcessInfo{}, errors.New("current argv exceeds inspection limit")
+	}
+	currentArgv, err := parseLinuxProcCmdline(rawArgv)
+	if err != nil {
+		return linuxBootstrapProcessInfo{}, err
+	}
+	return linuxBootstrapProcessInfo{
+		TrustedExecutable: os.SameFile(currentExecutable, stagedExecutable),
+		Argv:              currentArgv,
+	}, nil
+}
+
+func parseLinuxProcCmdline(raw []byte) ([]string, error) {
+	if len(raw) == 0 || raw[len(raw)-1] != 0 {
+		return nil, errors.New("current argv is empty or unterminated")
+	}
+	fields := bytes.Split(raw[:len(raw)-1], []byte{0})
+	if len(fields) == 0 || len(fields[0]) == 0 {
+		return nil, errors.New("current argv has no executable")
+	}
+	if len(fields) > linuxArgvExecMaxArgs {
+		return nil, errors.New("current argv has too many arguments")
+	}
+	argv := make([]string, 0, len(fields))
+	for _, field := range fields {
+		if len(field) > linuxArgvExecMaxStringBytes {
+			return nil, errors.New("current argv argument exceeds inspection limit")
+		}
+		argv = append(argv, string(field))
+	}
+	return argv, nil
