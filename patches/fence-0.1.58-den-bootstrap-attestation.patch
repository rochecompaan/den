+		{
+			name: "attested success", decision: linuxRuntimeExecDecision{Allow: true, AttestedBootstrapTransition: true},
+			wantNext: 1,
+		},
+		{
+			name: "stale response", decision: linuxRuntimeExecDecision{Allow: true, AttestedBootstrapTransition: true},
+			sendErr: unix.ENOENT, wantError: true,
+		},
+		{
+			name: "send failure", decision: linuxRuntimeExecDecision{Allow: true, AttestedBootstrapTransition: true},
+			sendErr: unix.EIO, wantError: true,
+		},
+		{
+			name: "ordinary success", decision: linuxRuntimeExecDecision{Allow: true},
+		},
+		{
+			name: "denied response success", decision: linuxRuntimeExecDecision{AttestedBootstrapTransition: true},
