+func TestReadLinuxBootstrapProcessInfoAt_RejectsOversizedCmdline(t *testing.T) {
+	procRoot := t.TempDir()
+	currentExecutable := filepath.Join(procRoot, "current-fence")
+	stagedExecutable := filepath.Join(procRoot, "root", strings.TrimPrefix(linuxBootstrapFencePath, "/"))
+	if err := os.MkdirAll(filepath.Dir(stagedExecutable), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(currentExecutable, []byte("fence"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(currentExecutable, filepath.Join(procRoot, "exe")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Link(currentExecutable, stagedExecutable); err != nil {
+		t.Fatal(err)
+	}
+	maxBytes := linuxArgvExecMaxArgs * (linuxArgvExecMaxStringBytes + 1)
+	if err := os.WriteFile(filepath.Join(procRoot, "cmdline"), bytes.Repeat([]byte{'x'}, maxBytes+1), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := readLinuxBootstrapProcessInfoAt(procRoot); err == nil || !strings.Contains(err.Error(), "current argv exceeds inspection limit") {
+		t.Fatalf("oversized cmdline error = %v", err)
+	}
+}
