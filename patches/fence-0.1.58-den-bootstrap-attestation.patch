+		return linuxBootstrapAttestationRejected, "target executable does not match the staged transition"
+	}
+	if !slices.Equal(argv, transition.TargetArgv) {
+		return linuxBootstrapAttestationRejected, "target argv does not match the staged transition"
+	}
+
+	expectedCurrentArgv := []string{linuxBootstrapFencePath, transition.SourceMode}
+	if state.debug {
