diff --git a/internal/sandbox/macos_test.go b/internal/sandbox/macos_test.go
index 14793d4..5914635 100644
--- a/internal/sandbox/macos_test.go
+++ b/internal/sandbox/macos_test.go
@@ -849,0 +850,63 @@ func TestWrapCommandMacOS_ExposedHostPathsSkipsMissing(t *testing.T) {
+
+func TestGenerateReadRules_CarvesNestedDeniedPathsOutOfAllow(t *testing.T) {
+	allowPath := "/fence/worktree"
+	deniedPath := "/fence/worktree/home/.pi/agent"
+	deniedGlob := "/fence/worktree/home/.ssh/id_*"
+	rules := generateReadRules(true, true, []string{allowPath}, []string{deniedPath, deniedGlob}, "test-log")
+	profile := strings.Join(rules, "\n")
+
+	want := strings.Join([]string{
+		"(allow file-read-data",
+		"  (require-all",
+		`    (subpath "/fence/worktree")`,
+		`    (require-not (literal "/fence/worktree/home/.pi/agent"))`,
+		`    (require-not (subpath "/fence/worktree/home/.pi/agent"))`,
+		`    (require-not (regex "^/fence/worktree/home/\\.ssh/id_[^/]*$"))`,
+	}, "\n")
+	if !strings.Contains(profile, want) {
+		t.Fatalf("nested deny paths were not carved out of read allow:\n%s", profile)
+	}
+}
+
+func TestGenerateWriteRules_CarvesNestedDeniedPathOutOfAllow(t *testing.T) {
+	allowPath := "/fence/worktree"
+	deniedPath := "/fence/worktree/home/.pi/agent"
+	rules := generateWriteRules([]string{allowPath}, []string{deniedPath}, true, allowPath, "test-log")
+	profile := strings.Join(rules, "\n")
+
+	want := strings.Join([]string{
+		"(allow file-write*",
+		"  (require-all",
+		`    (subpath "/fence/worktree")`,
+		`    (require-not (literal "/fence/worktree/home/.pi/agent"))`,
+		`    (require-not (subpath "/fence/worktree/home/.pi/agent"))`,
+	}, "\n")
+	if !strings.Contains(profile, want) {
+		t.Fatalf("nested deny path was not carved out of write allow:\n%s", profile)
+	}
+}
+
+func TestGenerateSandboxProfile_ReadOnlyDenyKeepsSpecificMoveProtection(t *testing.T) {
+	allowPath := "/fence/worktree"
+	deniedPath := "/fence/worktree/home/.pi/agent"
+	profile := GenerateSandboxProfile(MacOSSandboxParams{
+		WorkingDirectory: allowPath,
+		DefaultDenyRead:  true,
+		StrictDenyRead:   true,
+		ReadDenyPaths:    []string{deniedPath},
+		WriteAllowPaths:  []string{allowPath},
+		AllowGitConfig:   true,
+	})
+
+	for _, want := range []string{
+		"(deny file-write-unlink\n  (literal \"/fence/worktree/home/.pi/agent\")",
+		"(deny file-write-unlink\n  (literal \"/fence/worktree/home/.pi\")",
+	} {
+		if !strings.Contains(profile, want) {
+			t.Fatalf("read-only deny lost specific move protection %q:\n%s", want, profile)
+		}
+	}
+	if strings.Contains(profile, "(deny file-write*\n  (subpath \"/fence/worktree/home/.pi/agent\")") {
+		t.Fatalf("read-only deny unexpectedly blocked all writes:\n%s", profile)
+	}
+}
