+func seatbeltPathContains(root, path string) bool {
+	root = filepath.Clean(root)
+	path = filepath.Clean(path)
+	if root == path {
+		return true
+	}
+	relative, err := filepath.Rel(root, path)
+	return err == nil && relative != ".." && !strings.HasPrefix(relative, ".."+string(filepath.Separator))
+}
+
+func seatbeltDenyMayOverlapAllow(allowPath, denyPattern string) bool {
+	if allowPath == "" || ContainsGlobChars(allowPath) {
+		return true
+	}
+
+	staticDenyPath := denyPattern
+	if index := strings.IndexAny(denyPattern, "*?["); index >= 0 {
+		staticDenyPath = denyPattern[:index]
+		if staticDenyPath == "" {
+			return true
+		}
+		if !strings.HasSuffix(staticDenyPath, string(filepath.Separator)) {
+			staticDenyPath = filepath.Dir(staticDenyPath)
+		}
+	}
+
+	return seatbeltPathContains(allowPath, staticDenyPath) || seatbeltPathContains(staticDenyPath, allowPath)
+}
+
+func seatbeltDenyExclusionFilters(allowPath string, denyPaths []string) []string {
+	var filters []string
+	seen := make(map[string]struct{})
+	for _, pathPattern := range denyPaths {
+		normalized := NormalizePath(pathPattern)
+		if !seatbeltDenyMayOverlapAllow(allowPath, normalized) {
+			continue
+		}
+
+		var candidates []string
+		if ContainsGlobChars(normalized) {
+			candidates = []string{fmt.Sprintf("(require-not (regex %s))", escapePath(GlobToRegex(normalized)))}
+		} else {
+			candidates = []string{
+				fmt.Sprintf("(require-not (literal %s))", escapePath(normalized)),
+				fmt.Sprintf("(require-not (subpath %s))", escapePath(normalized)),
+			}
+		}
+		for _, candidate := range candidates {
+			if _, ok := seen[candidate]; ok {
+				continue
+			}
+			seen[candidate] = struct{}{}
+			filters = append(filters, candidate)
+		}
+	}
+	return filters
+}
+
+func addSeatbeltAllowRule(builder *seatbeltRuleBuilder, operation, filter string, exclusions []string, logTag string) {
+	ruleLines := []string{fmt.Sprintf("(allow %s", operation)}
+	if len(exclusions) == 0 {
+		if filter != "" {
+			ruleLines = append(ruleLines, "  "+filter)
+		}
+	} else {
+		ruleLines = append(ruleLines, "  (require-all")
+		if filter != "" {
+			ruleLines = append(ruleLines, "    "+filter)
+		}
+		for _, exclusion := range exclusions {
+			ruleLines = append(ruleLines, "    "+exclusion)
+		}
+		ruleLines = append(ruleLines, "  )")
+	}
+	if logTag != "" {
+		ruleLines = append(ruleLines, fmt.Sprintf("  (with message %q)", logTag))
+	}
+	ruleLines[len(ruleLines)-1] += ")"
+	builder.addRule(ruleLines...)
+}
