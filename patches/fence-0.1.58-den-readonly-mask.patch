+func (p *linuxLateMountPlanner) hasStrictAncestorMaskDir(path string) bool {
+	for _, mount := range p.mounts {
+		if (mount.Kind != linuxLateMountMaskDir && mount.Kind != linuxLateMountMaskDirReadOnly) || mount.Path == path {
+			continue
+		}
+		if linuxPathContains(mount.Path, path) {
+			return true
+		}
+	}
+	return false
+}
+
+func (p *linuxLateMountPlanner) promoteContainingMaskDir(path string) bool {
+	for i, mount := range p.mounts {
+		if mount.Kind == linuxLateMountMaskDir && linuxPathContains(mount.Path, path) {
+			p.mounts[i].Kind = linuxLateMountMaskDirReadOnly
+			return true
+		}
+	}
+	return false
+}
+
+func (p *linuxLateMountPlanner) hasDescendant(path string, kind linuxLateMountKind) bool {
+	for _, mount := range p.mounts {
+		if mount.Kind == kind && mount.Path != path && linuxPathContains(path, mount.Path) {
+			return true
+		}
+	}
+	return false
+}
