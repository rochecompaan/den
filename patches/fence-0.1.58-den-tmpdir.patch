+// validateDenFenceTMPDIR accepts only Den's already-created private scratch
+// directory. Invalid values fail closed instead of falling back to shared /tmp.
+func validateDenFenceTMPDIR(tmpDir string) string {
+	if !filepath.IsAbs(tmpDir) || filepath.Clean(tmpDir) != tmpDir {
+		return denFenceTMPDIRInvalid
+	}
+	info, err := os.Lstat(tmpDir)
+	if err != nil || info.Mode()&os.ModeSymlink != 0 || !info.IsDir() {
+		return denFenceTMPDIRInvalid
+	}
+	return tmpDir
