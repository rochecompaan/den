+func TestEnsureSandboxTMPDIRHonorsDenFenceTMPDIR(t *testing.T) {
+	t.Run("absent preserves upstream behavior", func(t *testing.T) {
+		t.Setenv(denFenceTMPDIREnv, "ignored")
+		if err := os.Unsetenv(denFenceTMPDIREnv); err != nil {
+			t.Fatal(err)
+		}
+		want := ensureSandboxTMPDIRPath(sandboxTMPDIR, sandboxTMPDIRFallback)
+		if got := ensureSandboxTMPDIR(); got != want {
+			t.Fatalf("ensureSandboxTMPDIR() = %q, want upstream %q", got, want)
+		}
+	})
+
+	t.Run("valid existing directory", func(t *testing.T) {
+		dir := t.TempDir()
+		t.Setenv(denFenceTMPDIREnv, dir)
+		if got := ensureSandboxTMPDIR(); got != dir {
+			t.Fatalf("ensureSandboxTMPDIR() = %q, want %q", got, dir)
+		}
+		if got := GenerateProxyEnvVars(0, 0); !containsString(got, "TMPDIR="+dir) {
+			t.Fatalf("GenerateProxyEnvVars() = %#v, want validated TMPDIR", got)
+		}
+	})
+
+	root := t.TempDir()
+	file := filepath.Join(root, "file")
+	if err := os.WriteFile(file, nil, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	link := filepath.Join(root, "link")
+	if err := os.Symlink(root, link); err != nil {
+		t.Fatal(err)
+	}
+	for name, value := range map[string]string{
+		"empty":         "",
+		"relative":      "relative/tmp",
+		"unclean":       root + "/.",
+		"missing":       filepath.Join(root, "missing"),
+		"non-directory": file,
+		"symbolic":      link,
+	} {
+		t.Run(name, func(t *testing.T) {
+			t.Setenv(denFenceTMPDIREnv, value)
+			if got := ensureSandboxTMPDIR(); got != denFenceTMPDIRInvalid {
+				t.Fatalf("ensureSandboxTMPDIR() = %q, want fail-closed %q", got, denFenceTMPDIRInvalid)
+			}
+		})
+	}
+}
+
+func containsString(values []string, want string) bool {
+	for _, value := range values {
+		if value == want {
+			return true
+		}
+	}
+	return false
+}
